# Buildkite Agent user service
# Generated by Ansible - do not edit manually
# Managed with: systemctl --user {start,stop,status} buildkite-agent

[Unit]
Description=Buildkite Agent (user service)
Documentation=https://buildkite.com/docs/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/buildkite-agent start --config {{ bk_config_dir }}/buildkite-agent.cfg
Restart=on-failure
RestartSec=5
TimeoutStartSec=10
# buildkite-agent reads BUILDKITE_AGENT_CONFIG before --config; keep them aligned.
Environment=BUILDKITE_AGENT_CONFIG={{ bk_config_dir }}/buildkite-agent.cfg

[Install]
WantedBy=default.target
